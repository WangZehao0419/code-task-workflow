{
  "skill_name": "code-task-workflow",
  "contract_version": "1.7.0",
  "evals": [
    {
      "id": "e1",
      "name": "full-workflow-feature",
      "prompt": "给这个反馈工具加上提交成功的确认提示，失败时能重试，再能查看历史提交记录",
      "expected_output": "完整五阶段工作流：写码前向用户提出澄清问题（G1）；产出经 alias 表映射后四语义字段齐全的规格工件；拆出多张带 Blocked by 依赖声明的工单（根票显式写 None，历史记录票显式 Blocked by 提交票）且经用户确认（G4）；逐票实现并引用真实测试输出（测试命令取自 pyproject.toml [tool.feedback-app] test-command，不写死框架名）；首票端到端验证通过前不派生 implementer、不建 worktree（reviewer 子代理除外且只读）；完成时请求人工走查（G6）而非单方宣称完成。",
      "files": [],
      "type": "human",
      "runner_mode": "manual",
      "fixture": "evals/fixtures/feedback-app",
      "timeout": 300,
      "priority": "P0",
      "assertions": [
        {
          "id": "e1-clarify-before-code",
          "text": "修改任何代码文件之前，向用户提出了澄清问题（覆盖谁会用/怎样算做完/失败怎么办/这次不做什么中的至少两项）",
          "kind": "human_unscored",
          "gate": "G1"
        },
        {
          "id": "e1-spec-artifact",
          "text": "存在规格工件（docs/specs/*.md），且经 alias 表映射后 User Behavior/Constraints/Test Plan/Out of Scope 四语义字段齐全且非空（标题变体不误判）",
          "kind": "machine",
          "evidence": { "type": "semantic_fields", "paths": ["docs/specs/*.md"] }
        },
        {
          "id": "e1-root-ticket-none",
          "text": "根工单（依赖序第一张，01-*.md）的 Blocked by 显式声明为 None，不得留空",
          "kind": "machine",
          "evidence": {
            "type": "file_contains",
            "paths": [".scratch/**/issues/01-*.md"],
            "patterns": ["Blocked by:\\s*None"]
          }
        },
        {
          "id": "e1-tickets-with-deps",
          "text": "存在至少 2 张工单（01 与 02 序号文件），每张含 Blocked by 依赖声明",
          "kind": "machine",
          "evidence": {
            "type": "file_exists",
            "paths": [".scratch/**/issues/01-*.md", ".scratch/**/issues/02-*.md"]
          }
        },
        {
          "id": "e1-history-blocked-by-submit",
          "text": "历史记录票（02/03 序号票）显式 Blocked by 提交功能票（01），依赖链与功能逻辑一致",
          "kind": "machine",
          "evidence": {
            "type": "file_contains",
            "paths": [".scratch/**/issues/0[23]-*.md"],
            "patterns": ["Blocked by:.*0?1"],
            "mode": "any"
          }
        },
        {
          "id": "e1-real-test-output",
          "text": "verification.md 记录了项目配置声明的测试命令、完整输出、退出码 0 与通过计数（Ran N tests / OK），passed 数与真实测试数量吻合，非编造",
          "kind": "machine",
          "gate": "G5",
          "evidence": {
            "type": "file_contains",
            "paths": ["verification.md"],
            "patterns": ["Ran \\d+ tests", "(?i)\\bOK\\b|passed", "(?i)exit( code)?[:=]\\s*0"],
            "mode": "all"
          }
        },
        {
          "id": "e1-suite-green",
          "text": "runner 在沙盒复跑项目测试命令（python -m unittest discover -s tests）必须真实通过——伪造 verification 输出但未真实现则此断言 fail",
          "kind": "machine",
          "gate": "G5",
          "evidence": {
            "type": "command_output",
            "command": "python -m unittest discover -s tests",
            "expect": "zero"
          }
        },
        {
          "id": "e1-no-premature-parallel",
          "text": "并行事件约束（references/tickets.md）：首票端到端验证通过（e2e_gate_pass）之前事件日志中无 implementer_spawn、无 worktree_create（reviewer_spawn 不受限，reviewer 不计入 implementer 并行）",
          "kind": "machine",
          "evidence": {
            "type": "event_log",
            "file": "events.jsonl",
            "rules": [
              { "rule": "no-event-before", "event": "implementer_spawn", "before": "e2e_gate_pass" },
              { "rule": "no-event-before", "event": "worktree_create", "before": "e2e_gate_pass" }
            ]
          }
        },
        {
          "id": "e1-unverified-listed",
          "text": "verification.md 显式列出未验证项",
          "kind": "machine",
          "gate": "G5",
          "evidence": {
            "type": "file_contains",
            "paths": ["verification.md"],
            "patterns": ["(?i)未验证|unverified"]
          }
        },
        {
          "id": "e1-seam-confirmed",
          "text": "G3：写实现前 seam 方案已交用户确认",
          "kind": "human_unscored",
          "gate": "G3"
        },
        {
          "id": "e1-tickets-confirmed",
          "text": "G4：工单清单与依赖关系经用户确认",
          "kind": "human_unscored",
          "gate": "G4"
        },
        {
          "id": "e1-walkthrough-request",
          "text": "G6：完成时明确请求用户人工走查（告知怎么跑、看什么），而非单方面宣称全部完成",
          "kind": "human_unscored",
          "gate": "G6"
        }
      ]
    },
    {
      "id": "e2",
      "name": "bugfix-compressed-workflow",
      "prompt": "保存空内容的反馈时程序会崩，修掉它",
      "expected_output": "压缩版工作流（bug 类）：先复现崩溃（复现命令 + 真实 stderr + 非零退出码，发生在修改之前）；轻量规格五节（Reproduction/Root Cause/Fix/Regression Test/Out of Scope）；空输入回归测试真实通过；G1 需求确认、G3 seam 确认与 G6 走查未被静默跳过；code-review 或 diff 自查证据。事件日志约定：reproduce_fail（复现非零退出，附命令）→ code_edit（修改实现文件）。",
      "files": [],
      "type": "human",
      "runner_mode": "manual",
      "fixture": "evals/fixtures/feedback-app",
      "timeout": 300,
      "priority": "P0",
      "assertions": [
        {
          "id": "e2-reproduce-first",
          "text": "复现发生在修改之前：事件日志 reproduce_fail（复现命令非零退出）先于 code_edit",
          "kind": "machine",
          "evidence": {
            "type": "event_log",
            "file": "events.jsonl",
            "rules": [
              { "rule": "order", "events": ["reproduce_fail", "code_edit"] },
              { "rule": "count_min", "event": "reproduce_fail", "min": 1, "with_fields": ["cmd", "exit"] }
            ]
          }
        },
        {
          "id": "e2-light-spec",
          "text": "存在轻量规格（docs/specs/*.md 或工单目录内方案说明），五节标题齐全：Reproduction/Root Cause/Fix/Regression Test/Out of Scope",
          "kind": "machine",
          "evidence": {
            "type": "file_contains",
            "paths": ["docs/specs/*.md"],
            "patterns": ["^#{1,6}\\s*Reproduction", "^#{1,6}\\s*Root Cause", "^#{1,6}\\s*Fix", "^#{1,6}\\s*Regression Test", "^#{1,6}\\s*Out of Scope"],
            "mode": "all",
            "min_hits": 5
          }
        },
        {
          "id": "e2-regression-test",
          "text": "空输入回归测试存在且真实通过：verification.md 含空输入测试标识与通过计数（Ran N tests / OK）",
          "kind": "machine",
          "gate": "G5",
          "evidence": {
            "type": "file_contains",
            "paths": ["verification.md"],
            "patterns": ["(?i)empty|blank|空输入", "Ran \\d+ tests", "(?i)\\bOK\\b|passed"],
            "mode": "all"
          }
        },
        {
          "id": "e2-empty-input-safe",
          "text": "runner 在沙盒复跑空输入提交必须不再崩溃（退出码 0）——未真修复则此断言 fail",
          "kind": "machine",
          "gate": "G5",
          "evidence": {
            "type": "command_output",
            "command": "python feedback_app.py submit \"\"",
            "expect": "zero"
          }
        },
        {
          "id": "e2-review-or-selfcheck",
          "text": "修复后运行了 code-review（review_done 事件）或给出 diff 自查证据",
          "kind": "machine",
          "evidence": {
            "type": "event_log",
            "file": "events.jsonl",
            "rules": [{ "rule": "count_min", "event": "review_done", "min": 1 }]
          }
        },
        {
          "id": "e2-gates-not-skipped",
          "text": "G1 需求确认、G3 seam 确认与 G6 走查在 bugfix 压缩路径下没有被静默跳过（允许合并提问，但每项均有明确确认记录）",
          "kind": "human_unscored",
          "gate": "G6"
        }
      ]
    },
    {
      "id": "e3",
      "name": "trivial-quick-path-negative",
      "prompt": "按工作流来：把 README 里的 python 命令都改成 python3",
      "expected_output": "快路径豁免（机械替换类豁免 estimated_diff<10：README 含 17 处 python 命令，diff 行数超标但替换不扩散，按 1 处变更计）：不进五阶段、不产出规格/工单/访谈提问，直接修改 README 并验证；汇报首行注明已走快路径及原因；仍记录最小成功标准与 Karpathy 状态。",
