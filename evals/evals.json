          "evidence": {
            "type": "file_contains",
            "paths": ["report.md"],
            "patterns": ["(?i)diff|grep|select-string|验证"]
          }
        },
        {
          "id": "e3-minimal-criteria-karpathy",
          "text": "最小成功标准与 Karpathy 状态（loaded / unavailable_reported）在汇报中可追溯",
          "kind": "machine",
          "evidence": {
            "type": "file_contains",
            "paths": ["report.md"],
            "patterns": ["Karpathy", "(?i)成功标准|判据|criteria"],
            "mode": "all"
          }
        },
        {
          "id": "e3-no-interview",
          "text": "未向用户提出 grilling 类访谈问题清单、未产出访谈记录（机械替换无行为歧义）",
          "kind": "human_unscored",
          "gate": "G1"
        }
      ]
    },
    {
      "id": "e4",
      "name": "reuse-research-decision",
      "prompt": "我要做一个书签管理小工具，从零做",
      "expected_output": "新项目任务：写码前先检索 GitHub/网络开源方案（research 事件附真实 URL 与时间），对候选做维护/部署/复用/修改点/License 分析（≥3 项），产出三选一复用决策建议（直接使用/基于改造/从零开发）及依据，请求用户确认（G2，确认问题原文已记录），确认前不写任何代码。",
      "files": [],
      "type": "human",
      "runner_mode": "manual",
      "timeout": 300,
      "priority": "P0",
      "assertions": [
        {
          "id": "e4-research-before-code",
          "text": "写任何代码之前检索了已有开源方案：research 事件（须含真实 url 字段）先于 code_edit，且 code_edit 不出现在 g2_confirm 之前",
          "kind": "machine",
          "evidence": {
            "type": "event_log",
            "file": "events.jsonl",
            "rules": [
              { "rule": "order", "events": ["research", "code_edit"] },
              { "rule": "count_min", "event": "research", "min": 1, "with_fields": ["url"] },
              { "rule": "no-event-before", "event": "code_edit", "before": "g2_confirm" }
            ]
          }
        },
        {
          "id": "e4-candidate-analysis",
          "text": "对候选项目分析了维护状态、部署难度、可复用功能、需修改点、License 中至少 3 项（research.md 五类模式命中 ≥3）",
          "kind": "machine",
          "evidence": {
            "type": "file_contains",
            "paths": ["research.md"],
            "patterns": ["维护|maintain|最近提交|release", "部署|deploy", "复用|reuse", "修改|改造|modify", "[Ll]icense|许可"],
            "min_hits": 3
          }
        },
        {
          "id": "e4-three-way-decision",
          "text": "给出三选一决策建议（直接使用/基于改造/从零开发）及依据",
          "kind": "machine",
          "evidence": {
            "type": "file_contains",
            "paths": ["research.md"],
            "patterns": ["直接使用|直接用|直接采用|基于改造|从零开发|从零写", "依据|理由|rationale"],
            "mode": "all"
          }
        },
        {
          "id": "e4-decision-gate",
          "text": "G2：复用决策请求用户确认（模拟用户模式下确认问题原文已记录），确认前未开始写码",
          "kind": "human_unscored",
          "gate": "G2"
        }
      ]
    },
